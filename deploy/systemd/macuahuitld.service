# Núcleo de MACUAHUITL como servicio de usuario (spec §5.1).
# El paquete .deb/.rpm la instala en /usr/lib/systemd/user/; cada usuario la activa con:
#   systemctl --user enable --now macuahuitld
[Unit]
Description=MACUAHUITL core
Documentation=https://github.com/oom-netsec/MACUAHUITL
# Si ya hay un núcleo corriendo (ErrAlreadyRunning) no tiene caso reintentar sin fin.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# La ruta real la fija el paquete (.deb/.rpm instala en /usr/bin).
ExecStart=/usr/bin/macuahuitld
Restart=on-failure
RestartSec=5

# Endurecimiento (spec §10.3, docs/security/THREAT_MODEL.md)
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitCORE=0
# Permite bloquear toda la memoria del núcleo. Un servicio de usuario no puede pasar del
# límite duro del gestor de usuario (user@.service): el administrador lo sube con
# LimitMEMLOCK=infinity en /etc/systemd/system/user@.service.d/ y un reinicio.
# DefaultLimitMEMLOCK en user.conf.d no basta. Sin eso el núcleo arranca igual y deja
# un aviso en la auditoría (internal/sys).
LimitMEMLOCK=infinity
UMask=0077

[Install]
WantedBy=default.target
