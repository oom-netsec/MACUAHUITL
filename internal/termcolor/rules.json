[
  {"cat": "dim",     "re": "^!(?:\\s.*)?$"},
  {"cat": "bad",     "re": "% (?:Invalid input(?: detected)?|Incomplete command|Ambiguous command|Unknown command)"},
  {"cat": "mnem",    "re": "%[A-Z][A-Z0-9_]*(?:-[A-Z0-9_]+)?-[0-7]-[A-Z0-9_]+"},
  {"cat": "prompt",  "re": "^[A-Za-z][\\w.-]{0,39}(?:\\([\\w-]+\\))?#"},
  {"cat": "uprompt", "re": "^[A-Za-z][\\w.-]{0,39}>"},
  {"cat": "ospf",    "re": "^O\\*?(?: ?(?:E[12]|N[12]|IA))?\\*?\\s"},
  {"cat": "eigrp",   "re": "^D\\*?(?: ?EX)?\\*?\\s"},
  {"cat": "bgp",     "re": "^B\\*?\\s"},
  {"cat": "rip",     "re": "^R\\*?\\s"},
  {"cat": "static",  "re": "^S\\*?\\s"},
  {"cat": "conn",    "re": "^[CL]\\*?\\s"},
  {"cat": "num",     "re": "\\[\\d+/\\d+\\]"},
  {"cat": "str",     "re": "\"[^\"]*\""},
  {"cat": "ok",      "re": "^\\s*no shutdown\\b|\\bno shutdown\\b"},
  {"cat": "kw",      "re": "^\\s*no\\b"},
  {"cat": "warn",    "re": "\\bshutdown\\b"},
  {"cat": "dim",     "re": "\\(hitcnt=0\\)"},
  {"cat": "num",     "re": "\\(hitcnt=[1-9]\\d*\\)"},
  {"cat": "warn",    "re": "\\[confirm\\]|\\(yes/no\\)|\\[yes/no\\]|Building configuration\\.\\.\\."},
  {"cat": "bad",     "re": "\\b(?:erase|delete|reload|telnet|disabled|half-duplex|never)\\b"},
  {"cat": "ok",      "re": "\\b(?:enabled|yes)\\b|\\[OK\\]"},
  {"cat": "cred",    "re": "\\b(?:username|password|secret|key-string|pre-shared-key)\\b"},
  {"cat": "acl",     "re": "\\b(?:access-list|access-group|access-class|object-group|time-range|prefix-list|route-map|class-map|policy-map|service-policy|use-acl)\\b"},
  {"cat": "svc",     "re": "\\b(?:ssh|tcp|udp|tftp|scp|ftp|ntp|snmp|icmp|hsrp|vrrp|gre|inspect)\\b"},
  {"cat": "ver",     "re": "\\b\\d{1,2}\\.\\d{1,2}\\(\\d+[a-z]?\\)[A-Za-z0-9]*|\\b1[5-9]\\.\\d{2}\\.\\d{2}[a-z]?\\b|\\b[A-Z]{3}\\d{4}[A-Z0-9]{4}\\b"},
  {"cat": "kw",      "re": "\\b(?:from-zone|to-zone|policy|match|then|source-address|destination-address|application|description|interface|hostname|switchport|router|ip address|ip route|channel-group|spanning-tree|vlan)\\b"},
  {"cat": "ok",      "re": "\\b(?:permit|accept)\\b"},
  {"cat": "bad",     "re": "\\b(?:deny|reject|drop)\\b"},
  {"cat": "ospf",    "re": "\\bOSPF\\b"},
  {"cat": "eigrp",   "re": "\\bEIGRP\\b"},
  {"cat": "bgp",     "re": "\\bBGP\\b"},
  {"cat": "rip",     "re": "\\bRIP\\b"},
  {"cat": "static",  "re": "\\bstatic\\b"},
  {"cat": "warn",    "re": "administratively down|admin-down|admin down"},
  {"cat": "bad",     "re": "Success rate is 0 percent|\\B\\.{3,}\\B|\\bnot (?:connected|reachable|ok)\\b|err-?disabled?|notconnect|\\b(?:down|errors?|failed|failure|denied|timeout|timed out|unreachable|refused|invalid|fatal|critical)\\b"},
  {"cat": "ok",      "re": "Success rate is 100 percent"},
  {"cat": "warn",    "re": "Success rate is \\d{1,2} percent"},
  {"cat": "ok",      "re": "\\b(?:up|full|established|forwarding|ok|connected|reachable|passed?)\\b|!{3,}"},
  {"cat": "warn",    "re": "\\b(?:idle|active|inactive|suspended|blocking|learning|listening|warning|warn|init|exstart)\\b"},
  {"cat": "dim",     "re": "\\b\\d{1,2}:\\d{2}:\\d{2}\\b|\\b\\d+[wd]\\d+[dh]\\b"},
  {"cat": "addr",    "re": "\\b[0-9a-f]{2}(?::[0-9a-f]{2}){5}\\b|\\b[0-9a-f]{2}(?:-[0-9a-f]{2}){5}\\b|\\b[0-9a-f]{4}\\.[0-9a-f]{4}\\.[0-9a-f]{4}\\b"},
  {"cat": "addr",    "re": "\\b(?:[0-9a-f]{1,4}:){1,7}:(?:[0-9a-f]{1,4}(?::[0-9a-f]{1,4}){0,6})?(?:/\\d{1,3})?|::[0-9a-f]{1,4}(?::[0-9a-f]{1,4}){0,6}(?:/\\d{1,3})?|\\b(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}(?:/\\d{1,3})?"},
  {"cat": "addr",    "re": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}(?:/\\d{1,2})?\\b"},
  {"cat": "iface",   "re": "\\b(?:(?:Gi|Te|Fa|Eth|Hu|Tw|Fo|Se|Lo|Vl|Tu|Mgmt|BDI|Nve)[a-z]*|Po|Port-channel|Et)\\d+(?:/\\d+){0,3}(?:\\.\\d+)?\\b"},
  {"cat": "dim",     "re": "\\b0 (?:input errors|output errors|CRC|runts|giants|drops?|collisions|overruns?|ignored|resets|frame|underruns|babbles)\\b"},
  {"cat": "bad",     "re": "\\b[1-9]\\d* (?:input errors|output errors|CRC|runts|giants|drops?|collisions|overruns?|ignored|resets|frame|underruns|babbles)\\b"},
  {"cat": "num",     "re": "\\b(?:CRC|crc errors?)\\b"},
  {"cat": "prompt",  "re": "^\\s*--\\s?More\\s?--"},
  {"cat": "kw",      "re": "\\b(?:exit|trunk|network|passive-interface|redistribute|default-gateway|ip routing|line vty|line con|logging|banner)\\b"}
]
